TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=
TARGET_CHANNEL_ID=
LLM_API_KEY=
LLM_BASE_URL=https://api.voidai.app/v1
# Preferred model. It is only a preference: when it stops answering, the parser
# probes known-good VoidAI models and translates with the first healthy one.
LLM_MODEL=gpt-5.1
# Set to false to pin translation to LLM_MODEL only (no probing, no rotation).
LLM_AUTO_SELECT_WORKING=true
# Optional: override the candidate list, ordered best first (chat models only).
LLM_WORKING_MODELS_CSV=
# How long a discovered working-model list is reused before re-probing (ms).
LLM_MODEL_HEALTH_TTL_MS=21600000
# Optional: a SECOND VoidAI host. Leave empty unless you have a distinct one —
# setting it equal to LLM_BASE_URL is ignored (it would only replay the same call).
LLM_FALLBACK_BASE_URL=
# OpenRouter — the only real backstop when VoidAI is down. Keep a valid key here.
# Key format: sk-or-v1-<64 hex chars>. Model must be a slug from
# https://openrouter.ai/api/v1/models (e.g. google/gemma-4-26b-a4b-it:free).
# An invalid key is detected on first use and the fallback is parked for 6h
# (look for "rejected our API key" in the logs) instead of failing every post.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
DATABASE_URL=postgresql://parser:password@localhost:5433/telegram_parser
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
# 32+ bytes hex/random. Generate: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
POLLER_INTERVAL_MS=60000
POLLER_INITIAL_SYNC_DAYS=30
# Background worker that translates PENDING posts saved without a translation
# (history fetches and the poller's initial sync store raw text on purpose).
TRANSLATION_BACKFILL_ENABLED=true
TRANSLATION_BACKFILL_INTERVAL_MS=300000
TRANSLATION_BACKFILL_BATCH=5
TRANSLATION_BACKFILL_DELAY_MS=3000
WEBHOOK_SECRET=
